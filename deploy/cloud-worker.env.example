DJANGO_SETTINGS_MODULE=railway_core.docker_worker
RAILWISE_BACKGROUND_MODE=operations
SECRET_KEY=replace-with-the-same-random-64-character-secret-used-on-render
ALLOWED_HOSTS=railwise-api.onrender.com
FRONTEND_URL=https://railwise-phi.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require
# Required by shared cloud settings; Docker jobs use their private Redis broker.
REDIS_URL=rediss://default:PASSWORD@YOUR-UPSTASH-HOST:6379/0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
