DEBUG=True
SECRET_KEY=local-development-only-change-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=irctc
DB_USER=irctc
DB_PASSWORD=local-dev-only
REDIS_URL=redis://127.0.0.1:6379/0

# Razorpay: use freshly generated TEST credentials locally. Never commit secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Separate secret configured in the Razorpay webhook dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Optional previous webhook secret during rotation.
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=

# Local emails print in the API console. Production: use SMTP + HTTPS frontend.
FRONTEND_URL=http://127.0.0.1:5173
ACCOUNT_LINK_TIMEOUT=1800
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Railwise <noreply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
BOOKING_EMAIL_MAX_ATTEMPTS=5

# Railway routes, pricing and inventory work offline after seed_data.
